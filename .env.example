# Copy file này thành .env rồi điền khoá thật.
# .env đã bị .gitignore chặn — KHÔNG BAO GIỜ commit khoá lên repo public.
# Điền MỘT trong hai là đủ. Code tự nhận key nào có thì dùng key đó.

# Gemini — lấy ở https://aistudio.google.com/apikey  (dạng AIzaSy...)
GEMINI_API_KEY=

# Claude — lấy ở https://console.anthropic.com  (dạng sk-ant-...)
ANTHROPIC_API_KEY=

# Bot Discord — Developer Portal, nhớ bật MESSAGE CONTENT INTENT
DISCORD_BOT_TOKEN=

# Webhook của kênh test, dùng cho codebase/do-tin-vao-kenh.py
DISCORD_WEBHOOK_URL=

# --- tuỳ chọn ---
# Ép dùng nhà cung cấp cụ thể: gemini | claude
# AI_PROVIDER=
# Đổi model nếu model mặc định không dùng được
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_MODEL=claude-opus-5
# Chỉ áp dụng cho Claude: low | medium | high
DIGEST_EFFORT=medium
# Cửa sổ bot quét, tính bằng ngày. Thiết kế chốt là 3 (xem spec.md §2)
# SO_NGAY_QUET=3
# Đặt =0 để ép gọi API mới thay vì đọc lại kết quả đã lưu trong eval/dem-api/
# DIGEST_CACHE=1
